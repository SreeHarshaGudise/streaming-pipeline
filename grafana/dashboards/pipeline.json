{
  "uid": "streaming-pipeline",
  "title": "Streaming Pipeline - Live",
  "tags": [
    "kafka",
    "spark"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Events (selected range)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "pg-events"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-events"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(SUM(event_count),0) AS \"events\" FROM event_agg WHERE $__timeFilter(window_start)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Error rate",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "pg-events"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-events"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 100.0*SUM(invalid_count)/NULLIF(SUM(valid_count+invalid_count),0) AS \"error rate\" FROM batch_metrics WHERE $__timeFilter(processed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Avg end-to-end latency",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "pg-events"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-events"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT AVG(avg_latency_ms) AS \"avg latency\" FROM batch_metrics WHERE $__timeFilter(processed_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Events / sec",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "pg-events"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-events"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT window_start AS time, SUM(event_count)/10.0 AS \"events/sec\" FROM event_agg WHERE $__timeFilter(window_start) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Latency per micro-batch (ms)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "pg-events"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-events"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT processed_at AS time, avg_latency_ms AS \"avg\", max_latency_ms AS \"max\" FROM batch_metrics WHERE $__timeFilter(processed_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Error rate % (malformed events sent to DLQ)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "pg-events"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-events"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT processed_at AS time, 100.0*invalid_count/NULLIF(valid_count+invalid_count,0) AS \"error %\" FROM batch_metrics WHERE $__timeFilter(processed_at) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Top event types",
      "type": "bargauge",
      "datasource": {
        "type": "postgres",
        "uid": "pg-events"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-events"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT event_type, SUM(event_count) AS total FROM event_agg WHERE $__timeFilter(window_start) GROUP BY 1 ORDER BY 2 DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        }
      }
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  }
}